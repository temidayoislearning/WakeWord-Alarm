{
  "expo": {
    "name": "WakeWord",
    "slug": "wakeword",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wakeword",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/icon.png",
      "imageWidth": 160,
      "resizeMode": "contain",
      "backgroundColor": "#F7F4EE"
    },
    "ios": {
      "bundleIdentifier": "com.temidayoislearning.wakeword",
      "supportsTablet": false
    },
    "android": {
      "package": "com.temidayoislearning.wakeword",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#192723"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/withWakeWordNativeAlarms",
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#E66B4E",
          "defaultChannel": "wakeword-alarms"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow WakeWord to record your voice for custom spoken alarms."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
